<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+ (older releases read backup_rules.xml).

   The EncryptedSharedPreferences stores are excluded from both. Each file carries its own
   Tink keysets, wrapped by an AndroidKeyStore master key that is never backed up or
   transferred, so a copied file can never be decrypted on the new device: it used to
   make SecurePrefs throw on every launch until the user cleared the app's data.
   Settings move between devices through the app's own backup (Settings > Backup).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="openclaw.node.secure.xml" />
        <exclude domain="sharedpref" path="cli-tool-config.secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="openclaw.node.secure.xml" />
        <exclude domain="sharedpref" path="cli-tool-config.secure.xml" />
    </device-transfer>
</data-extraction-rules>
