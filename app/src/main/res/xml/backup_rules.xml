<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API <= 30 (API 31+ reads data_extraction_rules.xml).

   The EncryptedSharedPreferences stores are excluded. Each file carries its own Tink
   keysets, wrapped by an AndroidKeyStore master key that never leaves the device, so a
   restored copy can never be decrypted: it used to make SecurePrefs throw on every
   launch until the user cleared the app's data. Settings move between devices through
   the app's own backup (Settings > Backup) instead.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="openclaw.node.secure.xml" />
    <exclude domain="sharedpref" path="cli-tool-config.secure.xml" />
</full-backup-content>
